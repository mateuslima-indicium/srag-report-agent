# Copie para .env e preencha. Nunca versionar o .env.
ANTHROPIC_API_KEY=
# Modelo do orquestrador. Alternativas: claude-opus-5-5 (mais caro), claude-haiku-5-5 (mais barato)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional: busca de noticias via Tavily. Vazio = usa RSS do Google News (sem chave)
TAVILY_API_KEY=
